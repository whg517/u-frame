{
  "name": "u-frame",
  "private": true,
  "version": "0.1.0-dev.1",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.20.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "bindings:check": "cargo run --manifest-path src-tauri/Cargo.toml --example export_bindings -- --check",
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --example export_bindings",
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "docs:check": "node scripts/check-docs.mjs",
    "governance:check": "node scripts/check-governance.mjs",
    "domain:check": "bash scripts/check-domain.sh",
    "test:tools": "node --test scripts/tests/*.test.mjs",
    "gate": "bash scripts/gate.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "release:build": "pnpm version:check && tauri build",
    "release:verify": "node scripts/release-artifacts.mjs verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "tauri": "tauri",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "react-router": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  }
}
