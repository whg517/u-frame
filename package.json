{
  "name": "u-frame",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "scripts": {
    "bindings:check": "cargo run --manifest-path src-tauri/Cargo.toml --example export_bindings -- --check",
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --example export_bindings",
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "docs:check": "node scripts/check-docs.mjs",
    "gate": "bash scripts/gate.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "release:build": "pnpm version:check && pnpm tauri build --target universal-apple-darwin --bundles app,dmg",
    "release:verify": "bash scripts/verify-macos-release.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.87.0",
    "react-router": "^7.18.3",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
